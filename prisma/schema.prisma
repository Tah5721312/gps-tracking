generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// 🎭 ENUMS
// ═══════════════════════════════════════════════════════════

enum VehicleStatus {
  moving // تتحرك
  stopped // متوقفة (المحرك شغال)
  turnoff // مطفية (المحرك مطفي)
}

// ═══════════════════════════════════════════════════════════
// 🚚 MODEL: Vehicle - المركبات
// ═══════════════════════════════════════════════════════════

model Vehicle {
  id          Int     @id @default(autoincrement())
  name        String  // اسم المركبة (مثل: سيارة 1)
  plateNumber String? // رقم اللوحة (اختياري)
  deviceImei  String  @unique // IMEI جهاز GPS

  // ربط المستخدم (المالك)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ربط السائق
  driverId Int? // معرف السائق
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // الحالة الحالية
  status VehicleStatus @default(turnoff)

  // آخر موقع معروف
  lastLatitude  Float?
  lastLongitude Float?
  lastSpeed     Float? // كم/س
  lastUpdate    DateTime? // آخر تحديث من GPS

  // معلومات التوقف
  stoppedAt        DateTime? // وقت بدء التوقف الحالي
  totalStoppedTime Int       @default(0) // إجمالي وقت الوقوف اليوم (بالثواني)

  // إحصائيات يومية (يتم إعادة تعيينها كل يوم)
  dailyDistance  Float     @default(0) // المسافة اليومية (كم)
  dailyMaxSpeed  Float     @default(0) // أقصى سرعة اليوم (كم/س)
  dailyStartTime DateTime? // وقت بدء العمل اليوم
  dailyStops     Int       @default(0) // عدد التوقفات اليوم
  lastResetDate  DateTime? @default(now()) // آخر reset للإحصائيات

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // العلاقات
  trackingPoints TrackingPoint[]
  dailyReports   DailyReport[]

  @@index([status])
  @@index([lastUpdate])
  @@index([driverId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// 👤 MODEL: Driver - السائقين
// ═══════════════════════════════════════════════════════════

model Driver {
  id         Int       @id @default(autoincrement())
  name       String // الاسم (مطلوب)
  phone      String    @unique // رقم التليفون (مطلوب)
  address    String // العنوان (مطلوب)
  nationalId String?   @unique // الرقم القومي
  province   String? // المحافظة
  birthDate  DateTime? @db.Date // تاريخ الميلاد
  notes      String?   @db.Text // ملاحظات

  // ربط المستخدم (المالك)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // العلاقات
  vehicles Vehicle[] // المركبات المرتبطة بهذا السائق

  @@index([name])
  @@index([phone])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// 📍 MODEL: TrackingPoint - نقاط التتبع
// ═══════════════════════════════════════════════════════════

model TrackingPoint {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // بيانات الموقع
  latitude  Float
  longitude Float
  speed     Float // كم/س
  heading   Float? // الاتجاه (0-360)

  // بيانات إضافية من GPS
  batteryLevel Int? // مستوى البطارية
  gpsAccuracy  Float? // دقة GPS (بالأمتار)
  altitude     Float? // الارتفاع

  timestamp DateTime // وقت التسجيل من GPS
  createdAt DateTime @default(now()) // وقت الإدخال في قاعدة البيانات

  @@index([vehicleId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}

// ═══════════════════════════════════════════════════════════
// 📊 MODEL: DailyReport - التقارير اليومية
// ═══════════════════════════════════════════════════════════

model DailyReport {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date DateTime @db.Date // التاريخ (بدون وقت)

  // إحصائيات الرحلة
  totalDistance    Float @default(0) // المسافة الكلية (كم)
  totalDuration    Int   @default(0) // مدة العمل (بالدقائق)
  totalStoppedTime Int   @default(0) // وقت التوقف الكلي (بالدقائق)
  totalMovingTime  Int   @default(0) // وقت الحركة (بالدقائق)

  // السرعات
  maxSpeed Float @default(0) // أقصى سرعة (كم/س)
  avgSpeed Float @default(0) // متوسط السرعة (كم/س)

  // التوقفات
  numberOfStops Int @default(0) // عدد التوقفات
  longestStop   Int @default(0) // أطول توقف (بالدقائق)

  // الأوقات
  firstMovement DateTime? // أول حركة في اليوم
  lastMovement  DateTime? // آخر حركة في اليوم

  // نقاط البداية والنهاية
  startLat Float?
  startLng Float?
  endLat   Float?
  endLng   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, date])
  @@index([date(sort: Desc)])
  @@index([vehicleId, date(sort: Desc)])
  @@index([vehicleId])
  @@index([firstMovement])
  @@index([lastMovement])
  @@index([date, firstMovement, lastMovement])
}

// ═══════════════════════════════════════════════════════════
// 🚨 MODEL: Alert - التنبيهات (اختياري)
// ═══════════════════════════════════════════════════════════

model Alert {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  type      String // speeding, stopped_too_long, engine_off, geofence
  severity  String // low, medium, high
  message   String
  latitude  Float?
  longitude Float?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vehicleId, isRead])
  @@index([createdAt(sort: Desc)])
}


enum UserRole {
  USER  // مستخدم عادي
  ADMIN // مدير
}


// ═══════════════════════════════════════════════════════════
// 👤 MODEL: User - المستخدمين
// ═══════════════════════════════════════════════════════════

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String   // hashed password
  role      UserRole @default(USER) // ADMIN أو USER
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // العلاقات
  vehicles Vehicle[] // المركبات المملوكة لهذا المستخدم
  drivers  Driver[]  // السائقين المملوكين لهذا المستخدم

  @@index([email])
  @@index([role])
  @@index([isActive])
}
